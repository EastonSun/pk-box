{
  // $schema：声明本配置对应的 JSON Schema 版本为 1.14.0-beta.2
  // 用途：编辑器（如 VSCode）可据此提供字段自动补全和校验提示
  // 疑惑点：文件名是 beta.1，但 schema 写的是 beta.2，需要确认这是否是笔误，
  //         还是作者故意先用 beta.2 的 schema 来"预测"字段变化（文件名含"预测参考"，
  //         推测这是提前适配下一个 beta 版本字段的草稿文件）
  "$schema": "https://sing-box.sagernet.org/schema/1.14.0-beta.2.json",

  // log：全局日志配置
  "log": {
    // level: "fatal" —— 只记录致命错误，几乎等于关闭日志输出
    // 说明：生产环境/日常使用建议保持较低日志级别以减少性能开销和隐私泄露风险；
    //       调试连接问题时可临时改为 "info" 或 "debug"
    "level": "fatal",
    // timestamp: true —— 日志行附带时间戳，便于排查时对照时间线
    "timestamp": true
  },

  // dns：DNS 解析与分流规则，是本配置最复杂的部分之一
  "dns": {
    "servers": [
      {
        // type: "hosts" —— 本地 hosts 映射类型的 DNS 服务器，用于强制固定域名解析结果
        "type": "hosts",
        "tag": "hosts_fix",
        // predefined：为特定域名硬编码 IP，避免这些域名被污染或解析到不可用地址
        // 说明：这里固定了 Cloudflare DoH、AdGuard DoH、Quad9 DoH 服务器自身的 IP，
        //       防止"DNS 服务器域名"本身的解析出问题，形成"先有鸡还是先有蛋"的死锁
        "predefined": {
          "cloudflare-dns.com": [
            "104.16.248.249",
            "104.16.249.249"
          ],
          "dns.adguard.com": [
            "94.140.14.15",
            "94.140.15.16"
          ],
          "dns.quad9.net": [
            "9.9.9.9",
            "149.112.112.112"
          ]
        }
      },
      {
        // type: "local" —— 使用系统/本地默认 DNS，通常用于查询国内直连域名
        "type": "local",
        "tag": "local-dns"
      },
      {
        // type: "fakeip" —— FakeIP 服务器：为匹配到的域名分配一个假的、
        //       本地虚拟网段内的 IP，配合 TUN 的域名嗅探实现"按域名分流"
        "type": "fakeip",
        "tag": "fakeip",
        // inet4_range：FakeIP 使用的 IPv4 网段，198.18.0.0/15 是 IANA 保留的
        //       "网络基准测试"地址段，不会与真实互联网地址冲突，是 FakeIP 常用选择
        "inet4_range": "198.18.0.0/15"
      },
      {
        // type: "https" —— 即 DoH（DNS over HTTPS），加密 DNS 查询防止被运营商窥探/篡改
        "type": "https",
        "tag": "cf-dns",
        // detour: "proxy" —— 该 DNS 请求本身要走代理出口发出，
        //       避免直连时被防火墙拦截或污染
        "detour": "proxy",
        // domain_resolver：解析 DoH 服务器域名本身所用的解析器，
        //       这里指向上面的 hosts_fix，形成"用固定 IP 来连 DoH 服务器"的闭环
        "domain_resolver": "hosts_fix",
        "server": "cloudflare-dns.com"
      },
      {
        "type": "https",
        "tag": "adguard-dns",
        "detour": "proxy",
        "domain_resolver": "hosts_fix",
        // AdGuard DoH 除了纯解析外，还自带广告/追踪域名过滤能力，
        // 因此下面 dns.rules 里会用它来做广告拦截的"竞速"判断源之一
        "server": "dns.adguard.com"
      },
      {
        "type": "https",
        "tag": "quad9-doh",
        "detour": "proxy",
        "domain_resolver": "hosts_fix",
        // Quad9 同样内置恶意/广告域名过滤，作为第二个广告拦截判断源，
        // 与 AdGuard 做"双源比对"提高拦截准确率
        "server": "dns.quad9.net"
      }
    ],

    // rules：DNS 层的分流/拦截规则，按顺序匹配，命中即按该条规则处理
    "rules": [
      {
        // 第一条：命中 BlockHttpDNS / AdGuardSDNSFilter / ads 规则集的域名直接拒绝解析
        // 作用：从 DNS 层面就把已知的 HttpDNS（运营商 DNS 劫持通道）和广告域名掐断，
        //       比在路由层拦截更彻底（连 IP 都不给）
        "rule_set": [
          "BlockHttpDNS",
          "AdGuardSDNSFilter",
          "ads"
        ],
        "action": "reject"
      },
      {
        // 第二条：所有 AAAA（IPv6）查询一律拒绝
        // 说明：结合下面 route 部分的 "ip_version 6 reject"，说明整个配置是
        //       彻底禁用 IPv6 的策略，避免 IPv6 泄露或双栈解析带来的额外延迟/复杂度
        "query_type": "AAAA",
        "action": "reject"
      },
      {
        // 第三条：SVCB / HTTPS(DNS 记录类型) / PTR 类型查询一律拒绝
        // 说明：SVCB/HTTPS 记录类型（不要和上面的 "https" DNS server type 混淆）
        //       是较新的 DNS 记录，用于服务发现，很多代理场景不需要，禁用可减少
        //       不必要的查询和潜在的信息泄露；PTR 是反向解析，日常也用不到
        "query_type": [
          "SVCB",
          "HTTPS",
          "PTR"
        ],
        "action": "reject"
      },
      {
        // 第四条：非 A / AAAA 类型的查询（invert 取反）一律拒绝
        // 综合上面三条规则可以看出这是层层加固：先禁广告域名、再禁 IPv6、
        //       再禁 SVCB/HTTPS/PTR，最后这条是兜底——只允许 A/AAAA 通过，
        //       其余杂七杂八的查询类型（如 TXT、MX、SRV 等）全部拒绝
        "query_type": [
          "A",
          "AAAA"
        ],
        "invert": true,
        "action": "reject"
      },
      {
        // 广告拦截"竞速"机制第一组：用 AdGuard DoH 查询 geosite-category-ads-all 规则集里的域名
        // action: "evaluate" 表示先求值但不立即返回结果，等待后面 match_response 决定是否采用
        "rule_set": "geosite-category-ads-all",
        "action": "evaluate",
        "server": "adguard-dns",
        "tag": "ad-1-ag"
      },
      {
        // 同一批域名再用 Quad9 DoH 查一遍，形成"双保险"
        "rule_set": "geosite-category-ads-all",
        "action": "evaluate",
        "server": "quad9-doh",
        "tag": "ad-1-q9"
      },
      {
        // 广告拦截第二组：用另一个规则集 geosite_adguard（AdGuard 社区维护的过滤规则）
        // 分别用 AdGuard 和 Quad9 两个源各查一次
        "rule_set": "geosite_adguard",
        "action": "evaluate",
        "server": "adguard-dns",
        "tag": "ad-2-ag"
      },
      {
        "rule_set": "geosite_adguard",
        "action": "evaluate",
        "server": "quad9-doh",
        "tag": "ad-2-q9"
      },
      {
        // match_response + action: "respond" + race: true
        // 含义：只要上面 4 组 evaluate 中的任意一组返回了"确实是广告"的结果，
        //       就立刻采用该结果作为最终响应（通常是 NXDOMAIN 或拦截页 IP），
        //       race: true 表示多个候选之间"谁先有结果就用谁"，提高响应速度
        "match_response": "ad-1-ag",
        "action": "respond",
        "race": true
      },
      {
        "match_response": "ad-1-q9",
        "action": "respond",
        "race": true
      },
      {
        "match_response": "ad-2-ag",
        "action": "respond",
        "race": true
      },
      {
        "match_response": "ad-2-q9",
        "action": "respond",
        "race": true
      },
      {
        // 命中 private 规则集（局域网/内网域名，如 .local、.lan 等）走本地 DNS 解析，
        // 不必也不应该经过公网 DoH
        "rule_set": "private",
        "server": "local-dns"
      },
      {
        // 命中国内域名（cn）以及微软中国区、苹果中国区、游戏中国区专用域名，
        // 一律走本地 DNS，因为这些域名在国内解析更准确、更快，
        // 走境外 DoH 反而可能拿到 CDN 节点不是最优的 IP
        "rule_set": [
          "cn",
          "microsoft-cn",
          "apple-cn",
          "games-cn"
        ],
        "server": "local-dns"
      },
      {
        // cdn.jsdelivr.net 单独走本地 DNS
        // 说明：jsdelivr 是本配置里 rule_set 远程规则文件的下载源（见下方 route.rule_set），
        //       用本地 DNS 解析可能是为了利用运营商 CDN 加速下载规则文件，
        //       但如果本地 DNS 被污染或该域名在国内被墙，可能导致规则集更新失败——这是一个潜在风险点
        "domain_suffix": "cdn.jsdelivr.net",
        "server": "local-dns"
      },
      {
        // 命中 Google/GoogleFCM/Android/proxy/gfw/ai 规则集的域名，
        // 使用 fakeip 分配虚拆 IP，rewrite_ttl: 300 表示重写 DNS TTL 为 300 秒，
        // 避免客户端缓存过久导致的切换延迟
        // 说明：这些是"明确需要代理"的域名分组：Google 服务、Google 消息推送(FCM)、
        //       安卓相关服务、自定义 proxy 规则集、GFW 关键词规则集、以及 AI 相关域名(如 OpenAI 等)
        "rule_set": [
          "Google",
          "GoogleFCM",
          "Android",
          "proxy",
          "gfw",
          "ai"
        ],
        "server": "fakeip",
        "rewrite_ttl": 300
      },
      {
        // 兜底分支一：其余未命中上述任何规则的域名，先尝试用 Cloudflare DoH 解析
        "action": "evaluate",
        "server": "cf-dns",
        "tag": "final-cf"
      },
      {
        // 兜底分支二：同时也用 AdGuard DoH 解析一遍
        "action": "evaluate",
        "server": "adguard-dns",
        "tag": "final-ag"
      },
      {
        // 两个兜底分支同样采用 race 竞速机制，谁先返回结果就用谁，
        // 兼顾了容错（一个挂了还有另一个）和速度（不用等最慢的那个）
        "match_response": "final-cf",
        "action": "respond",
        "race": true
      },
      {
        "match_response": "final-ag",
        "action": "respond",
        "race": true
      }
    ],

    // timeout: DNS 查询整体超时时间为 10 秒
    "timeout": "10s",
    // cache_capacity: DNS 缓存条目上限 16384 条，缓存命中可大幅降低重复查询延迟
    "cache_capacity": 16384,
    // optimistic：乐观 DNS 缓存——缓存过期后先返回旧结果给客户端，
    // 同时后台异步刷新，5 分钟超时，避免用户感知到解析延迟
    "optimistic": {
      "enabled": true,
      "timeout": "5m0s"
    }
  },

  // http_clients：sing-box 内部各模块发起 HTTP 请求（如 DoH、urltest 测速、
  //       规则集下载等）时使用的客户端参数模板
  // 疑惑点：这是较新版本才有的顶层字段（此前版本这些参数分散在各处），
  //       结合 profile 里记录的"1.13 到 1.14 之间 clash_api/cache_file 提升为顶层字段、
  //       http_clients 块格式变化"这一跟踪项，此处正是该变化的体现
  "http_clients": [
    {
      "tag": "default",
      // version: 2 —— 强制使用 HTTP/2
      "version": 2,
      // stream_receive_window / connection_receive_window: 0
      // 设为 0 表示使用协议默认值（不手动指定流控窗口大小），
      // 交给底层 HTTP/2 库自行管理
      "stream_receive_window": 0,
      "connection_receive_window": 0
    }
  ],

  // inbounds：入站配置，即流量如何"进入" sing-box
  "inbounds": [
    {
      // type: "tun" —— 创建一个虚拟网卡，接管系统全局流量（全局代理模式）
      "type": "tun",
      "tag": "tun-in",
      // mtu: 1500 —— 标准以太网 MTU，一般无需改动
      "mtu": 1500,
      // address: 虚拟网卡的 IP 地址及子网掩码
      "address": "10.8.0.1/24",
      // dns_mode: "hijack" —— 劫持所有经过 TUN 的 DNS 请求，强制走 sing-box 自身的 dns 模块处理
      // 说明：这是保证上面复杂 dns.rules 生效的前提，否则应用可能绕过 TUN 直接查询系统 DNS
      "dns_mode": "hijack",
      // auto_route: true —— 自动配置系统路由表，把流量导向 TUN 网卡
      "auto_route": true,
      // strict_route: true —— 严格路由模式，防止流量绕过 TUN（尤其是 Android 上常见的漏出问题）
      "strict_route": true,
      // udp_timeout: UDP 会话空闲超时时间为 1 分钟
      "udp_timeout": "1m0s",
      // stack: "system" —— 使用系统协议栈处理 TUN 流量（相对 gVisor 更贴近原生性能，
      //       但某些平台上兼容性/权限要求不同）
      // 疑惑点：结合 profile 记录中提到的 "TUN/gVisor stack" 这一关注点，
      //       这里选择了 system 而非 gvisor/mixed，需要确认是否是特意为了性能/兼容性权衡，
      //       如果在 Android 上遇到问题可尝试切换为 "gvisor" 或 "mixed"
      "stack": "system",
      // endpoint_independent_nat: true —— 独立于目标地址的 NAT 映射，
      // 改善某些 P2P/UDP 打洞场景的兼容性（如游戏联机、语音通话）
      "endpoint_independent_nat": true
    }
  ],

  // outbounds：出站配置，即流量最终从哪里、以什么方式发出去
  "outbounds": [
    {
      // DIRECT：直连出口，不经过任何代理，用于国内域名/内网/无需代理的流量
      "type": "direct",
      "tag": "DIRECT"
    },
    {
      // selector：手动选择器，供用户在客户端界面手动切换节点/策略
      "type": "selector",
      "tag": "proxy",
      // outbounds 列表包含：自动测速选择(auto)、具体节点(节点名称 —— 占位符，
      //       需替换为实际节点标签)、以及直连(DIRECT) 作为兜底选项
      "outbounds": [
        "auto",
        "节点名称",
        "DIRECT"
      ],
      // default: 默认选中"节点名称"这个占位节点
      // 提醒：这是模板占位符，实际使用前必须把 "节点名称" 替换为真实节点的 tag，
      //       否则该出站会因引用不存在的 tag 而报错
      "default": "节点名称"
    },
    {
      // urltest：自动测速出站，会在其 outbounds 列表的节点间定期测速，
      // 自动选择延迟最低的一个
      "type": "urltest",
      "tag": "auto",
      // 同样引用了占位符"节点名称"，实际使用时应该是多个真实节点组成的列表，
      // 这样 urltest 才有意义（目前只有一个节点，测速择优的作用基本失效）
      "outbounds": [
        "节点名称"
      ],
      // url：测速探测地址，用 Google 的 204 空响应接口判断延迟和连通性
      "url": "http://www.gstatic.com/generate_204",
      // interval：每 10 分钟重新测速一次
      "interval": "10m0s"
    },
    // 节点配置：此处为注释占位符，表示实际部署时需要在此插入真实的节点出站配置
    // （如 VLESS+Reality、Hysteria2、Trojan、Shadowsocks 2022、TUIC v5、AnyTLS 等，
    //  具体协议视你的实际节点而定）
    //节点配置
  ],

  // route：路由规则，决定每一条具体连接（而不仅是 DNS 查询）最终走哪个出站
  "route": {
    "rules": [
      {
        // 第一条：对所有连接做协议嗅探（sniff），
        // 用于识别流量的真实协议/域名（尤其在 FakeIP 场景下，
        //       需要嗅探 TLS SNI 或 HTTP Host 来还原真实域名用于后续规则匹配）
        "action": "sniff"
      },
      {
        // 第二条：IPv6 连接一律拒绝，呼应前面 DNS 部分禁用 AAAA 的策略，
        // 确保整个链路彻底不使用 IPv6
        "ip_version": 6,
        "action": "reject"
      },
      {
        // 第三条：大量国内常见 App/网站域名后缀直连（DIRECT）
        // 覆盖：B站、抖音、字节系、微信/QQ/腾讯系、快手、DeepSeek/豆包(字节AI)、
        //       百度、阿里系(淘宝/支付宝/阿里云)、小米、京东、美团、拼多多、阅文、
        //       知乎、微博、爱奇艺、优酷、网易、小红书、豆瓣、携程、苏宁、滴滴 等
        // 说明：这些是国内厂商自有 CDN/服务器，直连速度远快于走代理，
        //       且这些域名多数即使被规则集(cn)覆盖，单独列出可以确保优先级更高、更精确
        "domain_suffix": [
          "bilibili.com",
          "hdslb.com",
          "bilicdn1.com",
          "bilicdn2.com",
          "douyin.com",
          ".douyin.com",
          "douyinvod.com",
          "snssdk.com",
          "byteimg.com",
          "toutiao.com",
          "bytedance.com",
          "weixin.qq.com",
          "wechat.com",
          "wx.qq.com",
          "qq.com",
          "qpic.cn",
          "gtimg.cn",
          "qlogo.cn",
          "tencent.com",
          "tencent-cloud.com",
          "qcloud.com",
          "kuaishou.com",
          "yximgs.com",
          "ksapisrv.com",
          "deepseek.com",
          "deepseek.ai",
          "doubao.com",
          "volces.com",
          "baidu.com",
          "bdstatic.com",
          "bcebos.com",
          "alicdn.com",
          "taobao.com",
          "aliapp.org",
          "alipay.com",
          "alipayobjects.com",
          "aliyuncs.com",
          "miui.com",
          "xiaomi.com",
          "jd.com",
          "360buyimg.com",
          "meituan.com",
          "meituan.net",
          "pddpic.com",
          "pinduoduo.com",
          "yuewen.com",
          "zhihu.com",
          "zhimg.com",
          "weibo.com",
          "weibocdn.com",
          "iqiyi.com",
          "iqiyipic.com",
          "youku.com",
          "youkucdn.com",
          "163.com",
          "126.com",
          "netease.com",
          "xiaohongshu.com",
          "xhscdn.com",
          "douban.com",
          "doubanio.com",
          "ctrip.com",
          "ctripcorp.com",
          "suning.com",
          "didi.com",
          "didiglobal.com"
        ],
        "outbound": "DIRECT"
      },
      {
        // 第四条：目标 IP 为私有地址（局域网 IP，如 192.168.x.x / 10.x.x.x）直连
        "ip_is_private": true,
        "outbound": "DIRECT"
      },
      {
        // 第五条：NTP 协议（网络时间同步）直连
        // 说明：时间同步通常不需要代理，且很多代理协议不擅长传输 UDP/NTP，直连更稳
        "protocol": "ntp",
        "outbound": "DIRECT"
      },
      {
        // 第六条：一批"必须走代理"的特定域名，走 proxy 出站
        // 包括：Hugging Face(AI模型托管)、sing-box 官网、GitHub 及其 raw 内容、
        //       自定义域名 372164885.xyz（个人域名，可能是自建服务）、
        //       Telegram 群组域名、DeepWiki、mobilegym.dev、colocrossing(VPS服务商)、
        //       white-plus.net、gamer520.com、以及路由测试工具 nxtrace 的落地页域名
        "domain_suffix": [
          "huggingface.co",
          "sing-box.sagernet.org",
          "github.com",
          "raw.githubusercontent.com",
          ".372164885.xyz",
          "372164885.xyz",
          "org.telegram.group",
          "deepwiki.com",
          "mobilegym.dev",
          ".colocrossing.com",
          "white-plus.net",
          ".gamer520.com",
          "lg.nxtrace.org"
        ],
        "outbound": "proxy"
      },
      {
        // 第七条：命中 Google/GoogleFCM/Android/proxy/gfw/ai/games/networktest
        // 这几个规则集的流量走代理
        // 说明：与 DNS 部分的规则基本对应，但这里多了 games（游戏加速相关域名）
        //       和 networktest（网络测速相关域名，如 speedtest 等）
        "rule_set": [
          "Google",
          "GoogleFCM",
          "Android",
          "proxy",
          "gfw",
          "ai",
          "games",
          "networktest"
        ],
        "outbound": "proxy"
      },
      {
        // 第八条：目标 IP 落在 198.18.0.0/15 网段（即前面 FakeIP 使用的网段）走代理
        // 说明：这是保证"被 FakeIP 标记过的流量"最终确实会被路由到代理出站的关键兜底规则，
        //       否则 FakeIP 分配的虚拟 IP 若被当成普通 IP 处理，可能因找不到路由而失败
        "ip_cidr": "198.18.0.0/15",
        "outbound": "proxy"
      },
      {
        // 第九条：命中国内域名(cn)或国内 IP 段(cnip)规则集，直连
        "rule_set": [
          "cn",
          "cnip"
        ],
        "outbound": "DIRECT"
      },
      {
        // 第十条：命中 private（局域网域名）规则集，直连
        // 说明：这条与前面第四条(ip_is_private)不同——第四条按 IP 判断，
        //       这条按域名规则集判断，两者互补覆盖"域名层面"和"IP层面"的内网场景
        "rule_set": "private",
        "outbound": "DIRECT"
      },
      {
        // 第十一条：微软中国区/苹果中国区/游戏中国区专用规则集，直连
        // 说明：这些通常是国际厂商在中国大陆特设的服务节点(如 Microsoft 365 中国世纪互联版)，
        //       直连能保证走到正确的区域节点，走代理反而可能连不上或体验更差
        "rule_set": [
          "microsoft-cn",
          "apple-cn",
          "games-cn"
        ],
        "outbound": "DIRECT"
      },
      {
        // 第十二条：一长串 UDP 端口黑名单，直接拒绝
        // 说明：这些端口涵盖了常见的：文件共享/P2P(BT: 6881-6889, 27000+系列)、
        //       数据库(3306/5432/1433)、远程桌面(3389)、VoIP/SIP(5060/5061)、
        //       多种已知易被滥用/扫描/攻击的端口、以及部分游戏/语音端口等
        // 目的：屏蔽这些高风险/高噪音端口的 UDP 流量，减少代理资源消耗和潜在安全风险
        // 疑惑点：其中混入了 80/443/853(DoH/DoT)/1900(SSDP)/2049(NFS) 等"正常"端口，
        //       如果误伤了一些依赖这些端口的正常 UDP 应用(如 QUIC 走 443 的 UDP)，
        //       可能导致部分网站(尤其启用 HTTP/3 的)体验异常，需要留意排查
        "network": "udp",
        "port": [
          20, 21, 22, 23, 25, 69, 80, 110, 123, 137, 138, 139, 143, 389, 443,
          445, 500, 514, 666, 853, 1194, 1433, 1701, 1719, 1720, 1723, 1900,
          2049, 2710, 3128, 3306, 3389, 3478, 3479, 4444, 4500, 4665, 4672,
          5060, 5061, 5349, 5350, 5353, 5355, 5432, 5900, 6443, 6711, 6776,
          6881, 6882, 6883, 6884, 6885, 6886, 6887, 6888, 6889, 7001, 7002,
          8000, 8080, 8443, 8612, 8766, 8767, 9090, 9987, 10000, 12345, 19302,
          27015, 27016, 27017, 27018, 27019, 27020, 27021, 27022, 27023,
          27024, 27025, 27026, 27027, 27028, 27029, 27030
        ],
        "action": "reject"
      },
      {
        // 第十三条：类似的 TCP 端口黑名单，直接拒绝
        // 说明：同样是常见服务/风险端口(FTP/SSH/Telnet/SMTP/数据库/远程桌面/
        //       部分木马常用端口如 1243/27374/31337 等)，与上面 UDP 列表逻辑一致
        // 疑惑点：同样包含 80/443 这两个最基础的网页端口，需要确认此规则的
        //       实际匹配范围——如果这条规则会拦掉正常的网页 TCP 连接，
        //       那所有网站都会打不开，因此这里极可能是"只针对特定场景"
        //       (比如仅针对某些特殊嗅探失败/未被上面规则捕获的连接兜底拦截)，
        //       建议实际部署前重点复核此规则的意图和顺序位置
        "network": "tcp",
        "port": [
          20, 21, 22, 23, 25, 80, 110, 143, 389, 443, 445, 666, 853, 1080,
          1194, 1433, 1719, 1720, 1723, 2049, 2710, 3128, 3306, 3389, 3478,
          3479, 4444, 4661, 4662, 5060, 5061, 5349, 5432, 5900, 6711, 6776,
          7001, 7002, 8000, 8080, 8443, 8612, 9090, 10000, 12345, 1243,
          27374, 3127, 31337
        ],
        "action": "reject"
      },
      {
        // 第十四条：逻辑或(or)规则——端口为 53 或协议为 dns 的连接，劫持为内部 DNS 处理
        // 说明：这一条其实与 inbounds 里 tun 的 dns_mode: hijack 是互相配合/双保险的，
        //       确保任何试图绕过嗅探直接发往 53 端口的 DNS 流量也会被拉回到 dns 模块处理
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        // 第十五条：命中 ads 规则集的流量拒绝
        // 说明：这是路由层面的广告拦截兜底——即使 DNS 层拦截漏过了某个广告域名
        //       (比如通过硬编码 IP 直接访问，绕开了域名解析)，这里按 IP/规则集再拦一次
        "rule_set": "ads",
        "action": "reject"
      },
      {
        // 第十六条：STUN 和 DTLS 协议流量拒绝，且 method: "drop"（直接丢弃不回应，
        //       而非返回 RST/ICMP 拒绝），可以理解为"静默丢弃"
        // 说明：STUN/DTLS 常见于 WebRTC(视频通话、P2P 打洞)，这里选择丢弃，
        //       可能是为了防止 WebRTC 泄露真实 IP(WebRTC 泄露是代理场景的经典隐私问题)，
        //       但代价是可能影响某些依赖 WebRTC 的正常应用(如部分在线会议、游戏语音)
        "protocol": [
          "stun",
          "dtls"
        ],
        "action": "reject",
        "method": "drop"
      },
      {
        // 第十七条：route-options 动作，对后续（未命中前面所有规则的）连接
        // 设置两个选项：
        // udp_disable_domain_unmapping: true —— 禁用 UDP 域名反向映射(通常与 FakeIP 配合，
        //       避免把 FakeIP 的 UDP 包错误地映射回原始域名导致混乱)
        // udp_connect: true —— 对 UDP 使用 connect() 语义（部分平台/场景下能提升性能或兼容性）
        "action": "route-options",
        "udp_disable_domain_unmapping": true,
        "udp_connect": true
      },
      {
        // 第十八条：对剩余连接执行一次显式的 DNS 解析(resolve)，超时 5 秒
        // 说明：这通常用于给出站(尤其是需要真实 IP 而非 FakeIP 的场景，
        //       比如某些出站协议不支持直接用域名连接)做最后的解析补充
        "action": "resolve",
        "timeout": "5s"
      },
      {
        // 第十九条（兜底）：以上所有规则都未命中的连接，最终都走 proxy 出站
        // 说明：这与最下面 route.final 字段功能重复(final 也是 "proxy")，
        //       此处显式写出一条兜底规则，属于"双重保险"写法，不会冲突，
        //       只是显得略微冗余
        "outbound": "proxy"
      }
    ],

    // rule_set：远程规则集定义，sing-box 会定期从这些 URL 下载 .srs 格式的规则文件
    "rule_set": [
      {
        "type": "remote",
        // 这一组规则集(cn/cnip/private/ads/proxy/ai/games/microsoft-cn/apple-cn/
        //       games-cn/networktest)全部来自同一个 GitHub 仓库 DustinWin/ruleset_geodata，
        //       通过 jsdelivr CDN 加速拉取，{tag} 是占位符，会被替换为具体的 tag 名
        "tag": [
          "cn",
          "cnip",
          "private",
          "ads",
          "proxy",
          "ai",
          "games",
          "microsoft-cn",
          "apple-cn",
          "games-cn",
          "networktest"
        ],
        "url": "https://cdn.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/{tag}.srs",
        // update_interval: 每 48 小时自动检查更新一次
        "update_interval": "48h0m0s"
      },
      {
        "type": "remote",
        // 这一组(Google/Android/GoogleFCM/BlockHttpDNS/AdGuardSDNSFilter)
        // 来自另一个仓库 senshinya/singbox_ruleset
        "tag": [
          "Google",
          "Android",
          "GoogleFCM",
          "BlockHttpDNS",
          "AdGuardSDNSFilter"
        ],
        "url": "https://cdn.jsdelivr.net/gh/senshinya/singbox_ruleset@main/rule/{tag}/{tag}.srs",
        "update_interval": "48h0m0s"
      },
      {
        "type": "remote",
        // gfw 规则集单独来自 MetaCubeX/meta-rules-dat 仓库(Clash Meta 生态维护的规则库)
        "tag": "gfw",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/gfw.srs",
        "update_interval": "48h0m0s"
      },
      {
        "type": "remote",
        // geosite_adguard 来自 217heidai/adblockfilters 仓库，是社区维护的 AdGuard 过滤规则转换版
        "tag": "geosite_adguard",
        "url": "https://cdn.jsdelivr.net/gh/217heidai/adblockfilters@main/rules/adblocksingbox.srs",
        "update_interval": "48h0m0s"
      },
      {
        "type": "remote",
        // geosite-category-ads-all 来自 SagerNet 官方(sing-box作者团队)维护的 sing-geosite 仓库
        "tag": "geosite-category-ads-all",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-category-ads-all.srs",
        "update_interval": "48h0m0s"
      }
    ],

    // final: "proxy" —— 全局兜底出站为代理（未命中任何 route.rules 的连接最终走这里）
    "final": "proxy",
    // find_neighbor: true —— 查找网络邻居，通常与局域网发现/组播相关的兼容性选项
    "find_neighbor": true,
    // auto_detect_interface: true —— 自动检测出站网络接口，
    // 避免 sing-box 自己的流量(如测速请求)又被 TUN 递归劫持形成死循环
    "auto_detect_interface": true,
    // default_domain_resolver: "cf-dns" —— 各出站/规则若未单独指定 domain_resolver，
    // 默认使用 Cloudflare DoH 解析域名
    "default_domain_resolver": "cf-dns",
    // default_http_client: "default" —— 对应上面 http_clients 数组里 tag 为 "default" 的客户端配置
    "default_http_client": "default"
  },

  // experimental：实验性功能配置
  "experimental": {
    // cache_file：持久化缓存文件配置
    // 说明：结合 profile 中记录的"clash_api/cache_file 提升为顶层字段"这一变化点，
    //       此处 cache_file 直接挂在 experimental 下（而不是更早版本可能存在的
    //       其他嵌套位置），需要对照 1.14 beta 的实际 changelog 再次确认字段位置是否最终稳定
    "cache_file": {
      "enabled": true,
      // path: "cache.db" —— 缓存文件相对路径，实际运行时是相对于 sing-box 工作目录
      "path": "cache.db",
      // store_fakeip: true —— 持久化保存 FakeIP 映射关系，重启后无需重新分配
      "store_fakeip": true,
      // store_dns: true —— 持久化保存 DNS 缓存
      // 说明：对应 profile 中"store_dns vs. 已弃用的 store_rdrc"这一跟踪点，
      //       此处使用的是新字段 store_dns，而非旧版的 store_rdrc，符合 1.14 的变更方向
      "store_dns": true
    }
  }
}

/* ========================= 总结与说明 =========================

一、整体架构总结：
本配置是一个"全局 TUN 模式 + FakeIP + 多 DoH 竞速 + 国内外分流"的完整方案，
核心设计思路可概括为四层：
  1. DNS 层：多重广告拦截(AdGuard+Quad9 双源竞速) → 内网/国内域名走本地DNS →
     需代理域名走 FakeIP → 其余域名走 Cloudflare/AdGuard DoH 竞速兜底
  2. 入站层：TUN 接管全局流量，dns_mode: hijack 强制流量经过内部 DNS 处理
  3. 路由层：国内域名/IP直连 → 内网直连 → 特定必代理域名/规则集走代理 →
     FakeIP网段回收进代理 → 大量端口黑名单拒绝 → DNS劫持 → 广告拦截 →
     STUN/DTLS防泄露丢弃 → 兜底走代理
  4. 出站层：仅一个 selector(proxy) + 一个 urltest(auto)，节点部分留空待填

二、需要你确认/补充的关键点：
  1. "节点名称"是占位符，出现在 selector.outbounds、selector.default、
     urltest.outbounds 三处，实际部署前必须替换为真实节点的 tag，
     且 //节点配置 处需要插入真正的节点出站配置(协议、地址、密钥等)。
  2. $schema 指向 1.14.0-beta.2，与文件名 beta.1 不一致，建议确认这是否是
     你有意提前对齐下一版本 schema 做的"预测性"草稿。
  3. TCP 端口黑名单里包含了 80/443 这类基础网页端口，需要重点复核该规则的
     真实作用范围，避免误伤正常网页浏览。
  4. UDP 端口黑名单同样包含 443，如果你有依赖 QUIC/HTTP3 的场景，
     可能会被此规则拒绝，需要按需评估是否要放行。
  5. cdn.jsdelivr.net 走 local-dns 解析，如果本地网络环境解析该域名不稳定，
     会影响所有 rule_set 规则文件的下载和更新。

======================================================================= */
